<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Included packages are resolved from the repo. nuget.org stays available
       for the .NET SDK targeting packs, which ship with the SDK toolchain. -->
  <packageSources>
    <clear />
    <add key="included" value="third_party/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
