# Optional local overrides. Copy to lab.env (gitignored) or rely on interactive prompts.
#   cp config/lab.env.example config/lab.env
#
# The first start writes any missing default below into lab.env. A line that is
# already there is left as it is. Commented lines and empty values are not written.
#
# When running scripts interactively you will be prompted; Enter accepts defaults.
# For automation: LAB_NONINTERACTIVE=1 ./scripts/phase1.sh --no-prompt

# --- Storage (keep large media off /home and out of the git repo) ---
# Work directory. The unzip, converted disks, and log live in source/ and tmp/
# under it. Point this at another filesystem when the kit disk is tight.
LAB_WORK_DIR=/virtualmachines
SOURCE_DIR=/virtualmachines/source
TMP_DIR=/virtualmachines/tmp
# VirtualBox creates the machine folders and the final disks here.
VM_ROOT=/virtualmachines
# Guest Additions ISO. Leave unset to use the ISO VirtualBox reports.
# VBOX_GUEST_ADDITIONS_ISO=/usr/lib/virtualbox/additions/VBoxGuestAdditions.iso

# Lab ZIP (user-supplied). May stay under Kit/Original or be copied into SOURCE_DIR.
LAB_ZIP_PATH=/virtualmachines/Kit/Original/Win11_25H2_Lab.zip
GUIDES_ZIP_PATH=/virtualmachines/Kit/Original/Win11_25H2_Guides.zip

# Hypervisor backend. virtualbox and proxmox are implemented.
# A new backend is a directory scripts/hypervisors/<name>/ plus config/hypervisors/<name>/.
HYPERVISOR=virtualbox

# Proxmox API. Used when HYPERVISOR=proxmox. The values below are the menu
# defaults and can be changed. Host and the token secret are different on every
# node. The TLS fingerprint is optional: leave it unset to skip the certificate
# check, or set the SHA256 pin so the token is sent only when it matches.
# Import storage receives the temporary qcow2 copy and must allow Import.
# The copy is rsync over SSH into the directory that storage reports.
# Disk storage holds the guest disks and must allow Disk image.
# PVE_KEEP_IMPORTS=1 leaves each copy in place. 0 removes it after that guest disk exists.
# The token secret stays in lab.env and is never logged.
# SSH user defaults to root. A blank host uses the API host. The menu asks for
# the SSH password at the start of a run and does not save it. A blank identity
# uses the default SSH key when a stage is run from the shell.
PVE_NODE=pve
PVE_IMPORT_STORAGE=local
PVE_STORAGE=local-lvm
PVE_KEEP_IMPORTS=0
PVE_BRIDGE=vmbr1
PVE_INTERNET_BRIDGE=vmbr0
PVE_TOKEN_ID=root@pam!root
PVE_SSH_USER=root
PVE_SSH_PORT=22
# virtio-win ISO downloaded on this machine. Every Proxmox stage stops until this file exists.
# Stage 3 reads the virtio-serial driver and the guest agent from it and plants them on each disk before the copy.
# PVE_VIRTIO_ISO=
# PVE_API_HOST=pve.example:8006
# PVE_TLS_FINGERPRINT=
# PVE_TOKEN_SECRET=

# Lab naming / network
LAB_PREFIX=HYD
LAB_NETWORK_NAME=CorpNet

# Convert independent disks at the same time. Set to 0 when the machine is short of disk speed or memory.
LAB_PARALLEL=1
